{
  "name": "soyo-salon",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/share/*"
    ]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://soyo-salon.withweple.workers.dev"
  }
}
